<Window x:Class="StableFPSRecorder.DevicePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Device"
        Width="420" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1">
            <TreeView x:Name="DeviceTree"
                      ItemsSource="{Binding}"
                      SelectedItemChanged="DeviceTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type local:DeviceTreeNode}"
                                              ItemsSource="{Binding Children}"
                                              xmlns:local="clr-namespace:StableFPSRecorder">
                        <TextBlock Text="{Binding DisplayName}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <TextBlock x:Name="LoadingText"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="Loading devices…"
                   FontStyle="Italic"
                   Foreground="Gray"
                   Visibility="Visible" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="OkButton"
                    Content="OK"
                    IsDefault="True"
                    IsEnabled="False"
                    Width="80"
                    Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="OkButton_Click" />
            <Button Content="Cancel"
                    IsCancel="True"
                    Width="80"
                    Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </Grid>
</Window>
