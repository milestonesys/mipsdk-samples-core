<Window x:Class="StableFPSRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StableFPS Recorder"
        Width="640"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <StackPanel Margin="16" VerticalAlignment="Center" Height="auto">

        <!-- ═══════════════════════ CONNECTION ═══════════════════════ -->
        <GroupBox Header="Connection" Margin="0,0,0,10" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Server URI:" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="ServerUriBox" Grid.Row="0" Grid.Column="1"
                         Text="http://localhost"
                         Style="{StaticResource InputStyle}" />

                <Label Grid.Row="1" Grid.Column="0" Content="Login type:" Style="{StaticResource LabelStyle}" />
                <ComboBox x:Name="LoginTypeBox" Grid.Row="1" Grid.Column="1"
                          Height="26" VerticalContentAlignment="Center"
                          SelectionChanged="LoginTypeBox_SelectionChanged">
                    <ComboBoxItem Content="Windows Default" IsSelected="True" />
                    <ComboBoxItem Content="Windows" />
                    <ComboBoxItem Content="Basic" />
                </ComboBox>

                <Label Grid.Row="2" Grid.Column="0" Content="Username:"
                       x:Name="UsernameLabel" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="UsernameBox" Grid.Row="2" Grid.Column="1"
                         Style="{StaticResource InputStyle}" />

                <Label Grid.Row="3" Grid.Column="0" Content="Password:"
                       x:Name="PasswordLabel" Style="{StaticResource LabelStyle}" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1"
                             Style="{StaticResource PasswordStyle}" />

                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="LoginButton"
                            Content="Login"
                            Width="90"
                            Style="{StaticResource PrimaryButton}"
                            Click="LoginButton_Click" />
                    <TextBlock x:Name="LoginStatusText"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="Not logged in."
                               Foreground="Gray" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════ DEVICE ═══════════════════════ -->
        <GroupBox Header="Device" Margin="0,0,0,10" Padding="8"
                  IsEnabled="{Binding IsLoggedIn, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Device:" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="DevicePathBox" Grid.Column="1"
                         IsReadOnly="True"
                         Style="{StaticResource InputStyle}"
                         Text="(no device selected)" />
                <Button Grid.Column="2"
                        Content="Browse…"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="BrowseDeviceButton_Click" />
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════ MODE ═══════════════════════ -->
        <GroupBox Header="Mode" Margin="0,0,0,10" Padding="8"
                  IsEnabled="{Binding IsLoggedIn, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel>
                <RadioButton x:Name="LiveRadio"
                             Content="Live"
                             IsChecked="True"
                             GroupName="Mode"
                             Checked="ModeRadio_Changed" />
                <RadioButton x:Name="RecordedRadio"
                             Content="Recorded"
                             GroupName="Mode"
                             Margin="0,6,0,0"
                             Checked="ModeRadio_Changed" />

                <Grid x:Name="StartTimePanel" Margin="0,8,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Start time (UTC):" Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="StartTimeBox" Grid.Column="1"
                             Style="{StaticResource InputStyle}"
                             ToolTip="ISO-8601, e.g. 2024-01-15T10:30:00"
                             Text="{Binding UtcNowMinus1Hour, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneTime}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ═══════════════════════ OUTPUT ═══════════════════════ -->
        <GroupBox Header="Output File" Margin="0,0,0,10" Padding="8"
                  IsEnabled="{Binding IsLoggedIn, RelativeSource={RelativeSource AncestorType=Window}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="File:" Style="{StaticResource LabelStyle}" />
                <TextBox x:Name="OutputFileBox" Grid.Column="1"
                         Style="{StaticResource InputStyle}"
                         TextChanged="OutputFileBox_TextChanged" />
                <Button Grid.Column="2"
                        Content="Browse…"
                        Margin="8,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Click="BrowseOutputFileButton_Click" />
            </Grid>
        </GroupBox>

        <!-- ═══════════════════════ RECORDING CONTROLS ═══════════════════════ -->
        <GroupBox Header="Recording" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton"
                            Content="▶  Start"
                            Width="100"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="StartButton_Click" />
                    <Button x:Name="StopButton"
                            Content="■  Stop"
                            Width="100"
                            IsEnabled="False"
                            Margin="12,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="StopButton_Click" />
                    <TextBlock x:Name="ErrorText"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Text="" />
                </StackPanel>

                <Border Grid.Row="1"
                        BorderBrush="#CCCCCC" BorderThickness="1"
                        Padding="8"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Bytes written:" FontWeight="SemiBold" />
                        <TextBlock x:Name="BytesWrittenText"
                                   FontSize="22"
                                   FontFamily="Consolas"
                                   Text="0 B"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

    </StackPanel>
</Window>
